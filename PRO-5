#include <stdio.h>

struct priority_scheduling {
    char process_name;
    int burst_time;
    int waiting_time;
    int turn_around_time;
    int priority;
};

int main()
{
    int n, total = 0, position;
    int ASCII_number = 65;
    float avg_waiting_time, avg_turnaround_time;
    struct priority_scheduling temp;

    printf("Enter the total number of Processes: ");
    scanf("%d", &n);

    struct priority_scheduling process[n];

    printf("\nEnter Burst Time and Priority:\n");

    for (int i = 0; i < n; i++) {
        process[i].process_name = ASCII_number++;

        printf("\nProcess %c\n", process[i].process_name);
        printf("Enter burst time: ");
        scanf("%d", &process[i].burst_time);

        printf("Enter priority: ");
        scanf("%d", &process[i].priority);
    }

    for (int i = 0; i < n; i++) {
        position = i;

        for (int j = i + 1; j < n; j++) {
            if (process[j].priority >
                process[position].priority)
                position = j;
        }

        temp = process[i];
        process[i] = process[position];
        process[position] = temp;
    }

    process[0].waiting_time = 0;

    for (int i = 1; i < n; i++) {
        process[i].waiting_time =
            process[i - 1].waiting_time +
            process[i - 1].burst_time;
    }

    total = 0;
    for (int i = 0; i < n; i++)
        total += process[i].waiting_time;

    avg_waiting_time = (float)total / n;

    total = 0;

    printf("\nProcess\tBurst\tPriority\tWaiting\tTurnaround\n");

    for (int i = 0; i < n; i++) {
        process[i].turn_around_time =
            process[i].burst_time + process[i].waiting_time;

        total += process[i].turn_around_time;

        printf("%c\t%d\t%d\t\t%d\t%d\n",
               process[i].process_name,
               process[i].burst_time,
               process[i].priority,
               process[i].waiting_time,
               process[i].turn_around_time);
    }

    avg_turnaround_time = (float)total / n;

    printf("\nAverage Waiting Time: %.2f",
           avg_waiting_time);
    printf("\nAverage Turnaround Time: %.2f\n",
           avg_turnaround_time);

    return 0;
}
