#include <stdio.h>

int main()
{
    int n, i, j, bt[20], p[20], temp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        p[i] = i + 1;
        printf("Enter burst time of P%d: ", p[i]);
        scanf("%d", &bt[i]);
    }

    for(i = 0; i < n-1; i++)
        for(j = i+1; j < n; j++)
            if(bt[i] > bt[j])
            {
                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;
                temp = p[i]; p[i] = p[j]; p[j] = temp;
            }

    printf("\nProcess\tBurst Time\tWaiting Time\n");

    int wt = 0;
    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t\t%d\n", p[i], bt[i], wt);
        wt += bt[i];
    }

    return 0;
}
