
#include <stdio.h>

int main()
{
    int n, i, quantum, time = 0, completed = 0;
    int at[10], bt[10], rem[10], wt[10], tat[10];
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter arrival and burst time of P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
        rem[i] = bt[i];
    }

    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    while(completed < n)
    {
        int executed = 0;

        for(i = 0; i < n; i++)
        {
            if(rem[i] > 0 && at[i] <= time)
            {
                executed = 1;

                if(rem[i] > quantum)
                {
                    time += quantum;
                    rem[i] -= quantum;
                }
                else
                {
                    time += rem[i];
                    rem[i] = 0;
                    completed++;

                    tat[i] = time - at[i];
                    wt[i] = tat[i] - bt[i];
                }
            }
        }

        if(executed == 0)
            time++;
    }

    printf("\nProcess\tBurst\tWaiting\tTurnaround\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\n",
               i + 1, bt[i], wt[i], tat[i]);

        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    printf("\nAverage Waiting Time: %.2f",
           avg_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n",
           avg_tat / n);

    return 0;
}
