#include <stdio.h>

void firstfit(int mp[], int p[], int m, int n) {
    int allocated[20] = {0};

    for (int i = 0; i < m; i++) {
        int found = 0;

        for (int j = 0; j < n; j++) {
            if (!allocated[j] && mp[j] >= p[i]) {
                printf("Process %d (%d) fits in partition %d (%d)\n",
                       i + 1, p[i], j + 1, mp[j]);
                allocated[j] = 1;
                found = 1;
                break;
            }
        }

        if (!found)
            printf("Process %d (%d) must wait\n", i + 1, p[i]);
    }
}

void bestfit(int mp[], int p[], int m, int n) {
    int allocated[20] = {0};

    for (int i = 0; i < m; i++) {
        int best = -1;

        for (int j = 0; j < n; j++) {
            if (!allocated[j] && mp[j] >= p[i]) {
                if (best == -1 || mp[j] < mp[best])
                    best = j;
            }
        }

        if (best != -1) {
            printf("Process %d (%d) fits in partition %d (%d)\n",
                   i + 1, p[i], best + 1, mp[best]);
            allocated[best] = 1;
        } else {
            printf("Process %d (%d) must wait\n", i + 1, p[i]);
        }
    }
}

void worstfit(int mp[], int p[], int m, int n) {
    int allocated[20] = {0};

    for (int i = 0; i < m; i++) {
        int worst = -1;

        for (int j = 0; j < n; j++) {
            if (!allocated[j] && mp[j] >= p[i]) {
                if (worst == -1 || mp[j] > mp[worst])
                    worst = j;
            }
        }

        if (worst != -1) {
            printf("Process %d (%d) fits in partition %d (%d)\n",
                   i + 1, p[i], worst + 1, mp[worst]);
            allocated[worst] = 1;
        } else {
            printf("Process %d (%d) must wait\n", i + 1, p[i]);
        }
    }
}

int main() {
    int m, n, mp[20], p[20], ch;

    printf("Number of memory partitions: ");
    scanf("%d", &n);

    printf("Number of processes: ");
    scanf("%d", &m);

    if (n < 1 || n > 20 || m < 1 || m > 20) {
        printf("Invalid number of partitions or processes.\n");
        return 1;
    }

    printf("Enter the memory partition sizes:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &mp[i]);

    printf("Enter the process sizes:\n");
    for (int i = 0; i < m; i++)
        scanf("%d", &p[i]);

    printf("\n1. First Fit\n2. Best Fit\n3. Worst Fit\n");
    printf("Enter your choice: ");
    scanf("%d", &ch);

    switch (ch) {
        case 1:
            firstfit(mp, p, m, n);
            break;
        case 2:
            bestfit(mp, p, m, n);
            break;
        case 3:
            worstfit(mp, p, m, n);
            break;
        default:
            printf("Invalid choice\n");
    }

    return 0;
}
